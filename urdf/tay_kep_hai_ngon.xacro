<?xml version="1.0"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro">
  <!--
    Tay kep song song hai ngon gan vao tool0 cua UR3e.

    Truc +Z cua tool0 huong ra ngoai mat bich, nen than kep keo dai theo +Z.
    Hai ngon truot doi xung theo truc X cua tool0; gia tri khop la khoang cach
    tu mat trong moi ngon toi tam kep, tuc do mo = 2 * gia tri khop.
      mo  : 0.0375 -> khe 75 mm (du rong cho khoi 45 mm co sai so vi tri)
      dong: 0.0230 -> khe 46 mm (chua 0.5 mm moi ben, vat duoc giu bang
            AttachedCollisionObject cua MoveIt chu khong bang ma sat)
    Diem kep (tay_kep_tcp) cach tool0 60 mm theo +Z, nam giua hai ngon.
  -->
  <xacro:property name="day_than" value="0.040"/>
  <xacro:property name="dai_ngon" value="0.038"/>
  <xacro:property name="day_ngon" value="0.012"/>
  <xacro:property name="rong_ngon" value="0.024"/>
  <xacro:property name="hanh_trinh" value="0.040"/>

  <xacro:macro name="khoi_ngon" params="ten mau">
    <link name="${ten}">
      <inertial>
        <mass value="0.04"/>
        <origin xyz="0 0 ${dai_ngon / 2}" rpy="0 0 0"/>
        <inertia ixx="0.0000068" ixy="0" ixz="0" iyy="0.0000053" iyz="0" izz="0.0000024"/>
      </inertial>
      <visual>
        <origin xyz="0 0 ${dai_ngon / 2}" rpy="0 0 0"/>
        <geometry><box size="${day_ngon} ${rong_ngon} ${dai_ngon}"/></geometry>
        <material name="${mau}"><color rgba="0.85 0.45 0.10 1"/></material>
      </visual>
      <collision>
        <origin xyz="0 0 ${dai_ngon / 2}" rpy="0 0 0"/>
        <geometry><box size="${day_ngon} ${rong_ngon} ${dai_ngon}"/></geometry>
      </collision>
    </link>
  </xacro:macro>

  <xacro:macro name="khop_ngon_ign" params="ten">
    <joint name="${ten}">
      <command_interface name="position">
        <param name="min">0.0</param>
        <param name="max">${hanh_trinh}</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">0.0375</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
  </xacro:macro>

  <xacro:macro name="tay_kep_hai_ngon" params="parent sim_ignition">
    <link name="tay_kep_than">
      <inertial>
        <mass value="0.18"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="0.000078" ixy="0" ixz="0" iyy="0.000174" iyz="0" izz="0.000204"/>
      </inertial>
      <visual>
        <geometry><box size="0.100 0.064 ${day_than}"/></geometry>
        <material name="than_kep_xam"><color rgba="0.22 0.24 0.27 1"/></material>
      </visual>
      <collision>
        <geometry><box size="0.100 0.064 ${day_than}"/></geometry>
      </collision>
    </link>

    <!-- Mat sau cua than kep ap sat mat bich tool0 -->
    <joint name="tool0_tay_kep_than" type="fixed">
      <parent link="${parent}"/>
      <child link="tay_kep_than"/>
      <origin xyz="0 0 ${day_than / 2}" rpy="0 0 0"/>
    </joint>

    <xacro:khoi_ngon ten="ngon_trai" mau="ngon_cam_trai"/>
    <xacro:khoi_ngon ten="ngon_phai" mau="ngon_cam_phai"/>

    <!-- Ngon bat dau cach mat duoi than kep 1 mm de hai hop va cham khong chong nhau -->
    <joint name="khop_ngon_trai" type="prismatic">
      <parent link="tay_kep_than"/>
      <child link="ngon_trai"/>
      <origin xyz="${day_ngon / 2} 0 ${day_than / 2 + 0.001}" rpy="0 0 0"/>
      <axis xyz="1 0 0"/>
      <limit lower="0.0" upper="${hanh_trinh}" effort="40.0" velocity="0.08"/>
      <dynamics damping="0.2" friction="0.0"/>
    </joint>

    <joint name="khop_ngon_phai" type="prismatic">
      <parent link="tay_kep_than"/>
      <child link="ngon_phai"/>
      <origin xyz="${-day_ngon / 2} 0 ${day_than / 2 + 0.001}" rpy="0 0 0"/>
      <axis xyz="-1 0 0"/>
      <limit lower="0.0" upper="${hanh_trinh}" effort="40.0" velocity="0.08"/>
      <dynamics damping="0.2" friction="0.0"/>
    </joint>

    <link name="tay_kep_tcp"/>
    <joint name="tay_kep_than_tcp" type="fixed">
      <parent link="tay_kep_than"/>
      <child link="tay_kep_tcp"/>
      <origin xyz="0 0 ${0.060 - day_than / 2}" rpy="0 0 0"/>
    </joint>

    <xacro:if value="${sim_ignition}">
      <ros2_control name="tay_kep_hai_ngon" type="system">
        <hardware>
          <plugin>ign_ros2_control/IgnitionSystem</plugin>
        </hardware>
        <xacro:khop_ngon_ign ten="khop_ngon_trai"/>
        <xacro:khop_ngon_ign ten="khop_ngon_phai"/>
      </ros2_control>
    </xacro:if>
  </xacro:macro>
</robot>
